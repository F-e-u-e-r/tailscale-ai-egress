# tailscale-ai-egress failover configuration (v1.1.0)
#
# Copy to generated/failover.env and edit. Precedence is:
#   explicit environment variable > generated/failover.env > built-in default.
# generated/ is local-only and is never committed.
#
# Keep comments on their own lines. Inline "KEY=value # comment" is tolerated
# (unquoted trailing comments are stripped), but standalone lines are clearest.
#
# Numeric values are validated when the controller/monitor starts: an
# out-of-range or non-numeric value is rejected with a clear error before any
# probing or switching. Seconds-valued settings are capped at 86400 (one day).

# --- Exit-node failover controller (failover-exit-node.sh) ---

# Exit node hostname, MagicDNS name, or Tailscale IP.
PRIMARY_EXIT_NODE=
FALLBACK_EXIT_NODE=

# Egress probe URL (example; swap for your own lightweight endpoint).
PROBE_TARGET=https://ipinfo.io

# Seconds between cycles in --watch mode (1-86400).
CHECK_INTERVAL=30

# Consecutive ping failures before a node is DOWN (integer >= 1).
FAIL_THRESHOLD=3

# Consecutive successes before a node is UP (integer >= 1).
OK_THRESHOLD=3

# Seconds to wait after a switch before another, anti-flap (0-86400).
COOLDOWN=60

# Per-node tailscale ping timeout, seconds (1-86400).
PING_TIMEOUT=5

# Egress HTTP probe timeout, seconds (1-86400).
PROBE_HTTP_TIMEOUT=5

# 1 = switch back when primary recovers, 0 = stay on fallback.
RESTORE_PRIMARY=1

# 1 = select primary when no exit node is selected yet, 0 = never impose one.
ENSURE_PRIMARY=0

# Seconds before the post-switch readback (0-86400).
READBACK_DELAY=1

# --- Connector high-availability monitor (monitor-connectors.sh) ---

# Connector hostname, MagicDNS name, or Tailscale IP.
PRIMARY_CONNECTOR=
FALLBACK_CONNECTOR=

# 1 = degrade when neither connector advertises routes, 0 = skip the route check.
REQUIRE_ROUTES=1

# --- Advanced tunables (optional; the defaults are fine for most setups) ---

# `tailscale status --json` timeout in seconds, bounded to (0, 86400]; an
# out-of-range value falls back to the 15s default.
# TAILSCALE_STATUS_TIMEOUT=15

# Seconds to wait for the controller lock before giving up (non-negative integer).
# LOCK_WAIT=30

# --- Connector switch (Model B, failover-connectors.sh) ---
# Advanced distinct-tag active connector switch; see docs/Failover.md
# "Advanced Mode" and docs/Configuration.md "Connector Switch".

# The two pool tags (both required for a switch; must be distinct).
PRIMARY_CONNECTOR_TAG=
FALLBACK_CONNECTOR_TAG=

# Advisory warning window after a switch, integer seconds in [0, 86400];
# 0 disables the warning. It never blocks a switch.
CONNECTOR_SWITCH_COOLDOWN=600
